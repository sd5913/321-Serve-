; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="321 Serve - Rice Rice Baby"
run/main_scene="res://scenes/level.tscn"
config/features=PackedStringArray("4.7")

[display]

window/size/viewport_width=1950
window/size/viewport_height=1050
window/size/window_width_override=1300
window/size/window_height_override=700
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(1, 0.98, 0.94, 1)
